# Variáveis do aplicativo (opcionais). Copie para `.env` apenas se quiser sobrescrever algo.
# A configuração do Firebase NÃO fica aqui: ela está versionada em firebaseConfig.json.

# Sobrescreve a URL da API definida em app.json → expo.extra.apiUrl (ex.: API local em testes;
# no celular use o IP do computador na rede, não localhost).
EXPO_PUBLIC_API_URL=http://localhost:3000
