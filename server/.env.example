# Variáveis da API para testes locais (npm run dev) e para o deploy opcional na AWS.
# Copie para server/.env (nunca versionado). No Render, os valores ficam no
# render.yaml e a chave vai como Secret File (veja o README).

# --- Firebase Admin -----------------------------------------------------------
# Opção 1 (recomendada): caminho do JSON da conta de serviço.
# Guarde o arquivo FORA do repositório.
FIREBASE_SERVICE_ACCOUNT_FILE=

# Opção 2: os campos separados (usados só se a opção 1 estiver vazia).
FIREBASE_PROJECT_ID=seu-project-id
FIREBASE_CLIENT_EMAIL=email-da-conta-de-servico@seu-project-id.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY=CONFIGURAR_APENAS_LOCALMENTE

# Sempre obrigatória.
FIREBASE_DATABASE_URL=https://cp2-mobile-f6f46-default-rtdb.firebaseio.com

# Opcional: token de acesso do Expo, se "Enhanced Security for Push" estiver ligado no EAS.
EXPO_ACCESS_TOKEN=

# --- Execução local -----------------------------------------------------------
PORT=3000

# --- Opcional: deploy na AWS (npm run deploy:aws; veja server/aws/README.md) ---
# AWS Academy (Learner Lab) só permite us-east-1 e us-west-2.
AWS_REGION=us-east-1
STACK_NAME=cp2-chat-api
# Opcional. Vazio = usa a LabRole do AWS Academy, se existir, ou cria uma role mínima.
LAMBDA_ROLE_ARN=
