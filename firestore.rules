rules_version = '2';

// Regras do Cloud Firestore — CP2 Chat.
// Publicar com: firebase deploy --only firestore:rules
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null
        && request.auth.token.firebase.sign_in_provider == 'password';
    }

    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function isInt(value) {
      return value is int;
    }

    // ------------------------------------------------------------------
    // Perfil público: só nome e foto (necessários para a lista/busca de
    // usuários). Dados cadastrais ficam em /private/profile.
    // ------------------------------------------------------------------
    match /users/{userId} {
      allow read: if signedIn();

      allow create: if isSelf(userId)
        && request.resource.data.keys().hasOnly(['uid', 'name', 'photoUrl', 'createdAt'])
        && request.resource.data.uid == userId
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 2
        && request.resource.data.name.size() <= 60
        && request.resource.data.photoUrl is string
        && isInt(request.resource.data.createdAt);

      allow update: if isSelf(userId)
        && request.resource.data.keys().hasOnly(['uid', 'name', 'photoUrl', 'createdAt'])
        && request.resource.data.uid == userId
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 2
        && request.resource.data.name.size() <= 60
        && request.resource.data.photoUrl is string;

      allow delete: if false;

      // Dados cadastrais: somente o próprio usuário lê/escreve pelo SDK.
      // Quem compartilha conversa ou grupo recebe esses dados pela API
      // (GET /users/:uid/profile), que valida o vínculo com o Admin SDK.
      match /private/{docId} {
        allow read: if isSelf(userId) && docId == 'profile';
        allow write: if isSelf(userId)
          && docId == 'profile'
          && request.resource.data.keys().hasOnly(['email', 'phoneNumber', 'birthDate'])
          && request.resource.data.email == request.auth.token.email
          && request.resource.data.phoneNumber is string
          && request.resource.data.phoneNumber.matches('^[0-9]{10,11}$')
          && request.resource.data.birthDate is string
          && request.resource.data.birthDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
      }

      // Tokens de push: nunca públicos.
      match /devices/{deviceId} {
        allow read, delete: if isSelf(userId);
        allow create, update: if isSelf(userId)
          && request.resource.data.keys().hasOnly(['token', 'platform', 'enabled', 'updatedAt', 'disabledReason'])
          && request.resource.data.token is string
          && request.resource.data.platform in ['ios', 'android']
          && request.resource.data.enabled is bool
          && isInt(request.resource.data.updatedAt);
      }
    }

    // ------------------------------------------------------------------
    // Grupos
    // ------------------------------------------------------------------
    function validGroup(group, groupId) {
      return group.keys().hasOnly(['id', 'name', 'photoUrl', 'ownerId', 'memberIds', 'memberLimit',
                                   'notificationPolicy', 'createdAt', 'updatedAt'])
        && group.id == groupId
        && group.name is string && group.name.size() >= 2 && group.name.size() <= 60
        && group.photoUrl is string
        && group.memberIds is list
        && group.memberIds.size() >= 2
        && group.memberIds.toSet().size() == group.memberIds.size()
        && group.ownerId in group.memberIds
        && group.memberLimit is int
        && group.memberLimit >= 2
        && group.memberLimit <= 100
        // Limite de integrantes validado no banco, a cada escrita.
        && group.memberIds.size() <= group.memberLimit
        && group.notificationPolicy in ['all_group_messages', 'mentioned_members', 'direct_messages_only', 'disabled']
        && isInt(group.createdAt)
        && isInt(group.updatedAt);
    }

    match /groups/{groupId} {
      allow read: if signedIn() && request.auth.uid in resource.data.memberIds;

      allow create: if signedIn()
        && request.resource.data.ownerId == request.auth.uid
        && validGroup(request.resource.data, groupId);

      // Somente o proprietário altera o grupo; dono, id e data de criação são imutáveis.
      allow update: if signedIn()
        && resource.data.ownerId == request.auth.uid
        && request.resource.data.ownerId == resource.data.ownerId
        && request.resource.data.createdAt == resource.data.createdAt
        && validGroup(request.resource.data, groupId);

      allow delete: if signedIn() && resource.data.ownerId == request.auth.uid;
    }

    // ------------------------------------------------------------------
    // Conversas individuais: ID = uids ordenados unidos por "_".
    // Isso impede duas conversas para o mesmo par e conversa consigo mesmo.
    // ------------------------------------------------------------------
    match /directConversations/{conversationId} {
      // `resource == null` permite checar se a conversa já existe antes de criá-la.
      allow get: if signedIn()
        && (resource == null || request.auth.uid in resource.data.participantIds);
      allow list: if signedIn() && request.auth.uid in resource.data.participantIds;

      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['id', 'participantIds', 'createdAt'])
        && request.resource.data.id == conversationId
        && request.resource.data.participantIds is list
        && request.resource.data.participantIds.size() == 2
        && request.auth.uid in request.resource.data.participantIds
        && request.resource.data.participantIds[0] < request.resource.data.participantIds[1]
        && conversationId == request.resource.data.participantIds[0] + '_' + request.resource.data.participantIds[1]
        && exists(/databases/$(database)/documents/users/$(request.resource.data.participantIds[0]))
        && exists(/databases/$(database)/documents/users/$(request.resource.data.participantIds[1]))
        && isInt(request.resource.data.createdAt);

      allow update, delete: if false;
    }

    // Controle de idempotência do push: somente a API (Admin SDK).
    match /notificationDeliveries/{deliveryId} {
      allow read, write: if false;
    }
  }
}
