rules_version = '2';

// Regras do Firebase Storage — fotos de perfil e de grupo.
// Publicar com: firebase deploy --only storage
service firebase.storage {
  match /b/{bucket}/o {

    function isImage() {
      return request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    // Foto de perfil: qualquer usuário autenticado vê; só o dono envia.
    match /users/{userId}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId && isImage();
    }

    // Foto do grupo: só o proprietário (conferido no Firestore) envia.
    match /groups/{groupId}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && isImage()
        && firestore.get(/databases/(default)/documents/groups/$(groupId)).data.ownerId == request.auth.uid;
    }
  }
}
